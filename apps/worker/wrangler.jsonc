{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sebastian",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Sentry's SDK needs AsyncLocalStorage and diagnostics_channel.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sebastian.baltar.media", "custom_domain": true }],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // The web UI (apps/web, built first). run_worker_first: every request, assets included,
  // passes the Access check in the Worker before ASSETS serves it.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  "durable_objects": {
    "bindings": [
      { "name": "INSTALL", "class_name": "InstallDO" },
      { "name": "STREAM", "class_name": "StreamDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InstallDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StreamDO"] }
  ],

  "workflows": [{ "name": "sebastian-apply", "binding": "APPLY", "class_name": "ApplyWorkflow" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sebastian",
      // Created 2026-11-04 (ENAM).
      "database_id": "3b11b032-333f-46ae-bb6c-2002a34ac290",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    // Token health + ledger rollup every 30 min; retention daily at 09:17 UTC.
    "crons": ["*/30 * * * *", "17 9 * * *"]
  },

  "vars": {
    "PUBLIC_ORIGIN": "https://sebastian.baltar.media",
    // Zero Trust team domain, without https:// — e.g. "baltar.cloudflareaccess.com".
    // Zero Trust > Settings > Team name and domain.
    "ACCESS_TEAM_DOMAIN": "erodewald.cloudflareaccess.com",
    // Application Audience (AUD) tag: Zero Trust > Access controls > Applications >
    // (sebastian.baltar.media) > Edit > Additional settings.
    "ACCESS_AUD": "e10a7bc2a94f3407de29483f033a0cb2ddce9ad6edf8901bf188330028a0ec02",
    // Scenes (r:scenes:* x:scenes:*) are registered on the app but NOT requested: asking for
    // both together makes SmartThings' authorize fail with server_error, though each alone works
    // (bisected 2026-11-05). Revisit with the M2 scene-in-rule spike.
    // x:rules:* is needed by POST /rules/execute (seb run): without it, 403
    // execute-behavior-fail-invalid-scopes. It isn't in the documented scope table.
    // No installed-apps scope: r:installedapps isn't a valid API Access app scope (adding it to the
    // 9 below gives server_error), and the callback's own GET /installedapps/{id} works without it.
    "ST_SCOPES": "r:devices:* x:devices:* r:hubs:* r:locations:* w:locations:* x:locations:* r:rules:* w:rules:* x:rules:* sse",
    // SmartThings appId (not a secret); lifecycle CONFIRMATION is accepted only for this app.
    "ST_APP_ID": "dd2a50f8-3307-445b-afc5-c9150094bcc9",
    "USER_AGENT": "sebastian/0.0 (+https://github.com/erodewald/sebastian)",
    // Overridden to "development" in .dev.vars.
    "SENTRY_ENVIRONMENT": "production"
  }
  // Secrets (wrangler secret put): ST_CLIENT_ID, ST_CLIENT_SECRET, DATA_KEY (base64, 32 bytes),
  // SENTRY_DSN (optional; leaving it unset turns Sentry off)
}
